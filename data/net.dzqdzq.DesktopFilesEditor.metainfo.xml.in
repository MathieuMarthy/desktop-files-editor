<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>net.dzqdzq.DesktopFilesEditor</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name translate="no">Desktop Files Editor</name>
  <summary>Manage your .desktop files</summary>
  <description>
    <p>Every application in your launcher is described by a .desktop file. Desktop Files Editor gathers them in one list, so you can change them without searching through folders or editing text files by hand.</p>
    <p>Your user, system and Flatpak applications are all listed. System files are never modified: when you change one, a copy is saved in your personal folder, and you can restore the original at any time.</p>
    <p>Features:</p>
    <ul>
      <li>Browse and search all your applications</li>
      <li>Edit the name, icon, comment and command of an application</li>
      <li>Hide applications from your launcher, and show them again</li>
      <li>Create new applications</li>
      <li>Delete your own applications or restore the original ones, with undo</li>
      <li>Copy the path of a .desktop file</li>
      <li>Work faster with keyboard shortcuts</li>
    </ul>
  </description>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/MathieuMarthy/desktop-files-editor/main/assets/app-screenshot-light.png</image>
