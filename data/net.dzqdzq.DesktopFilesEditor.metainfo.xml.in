<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>net.dzqdzq.DesktopFilesEditor</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name translate="no">Desktop Files Editor</name>
  <summary>Manage your .desktop files</summary>
  <description>
    <p>With Desktop Files Editor you can see, edit, add or remove your .desktop files.</p>
  </description>

  <developer id="net.dzqdzq">
    <name translate="no">Mathieu Marthy</name>
  </developer>

  <url type="homepage">https://github.com/MathieuMarthy/desktop-files-editor</url>
  <url type="vcs-browser">https://github.com/MathieuMarthy/desktop-files-editor</url>
  <url type="bugtracker">https://github.com/MathieuMarthy/desktop-files-editor/issues</url>
  <url type="translate">https://github.com/MathieuMarthy/desktop-files-editor/blob/main/po/README.md</url>
  <url type="contribute">https://github.com/MathieuMarthy/desktop-files-editor#contributing</url>
  <translation type="gettext">desktop-files-editor</translation>
  <launchable type="desktop-id">net.dzqdzq.DesktopFilesEditor.desktop</launchable>
  <content_rating type="oars-1.1" />

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#ff00ff</color>
    <color type="primary" scheme_preference="dark">#993d3d</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-10-09" />
  </releases>

</component>