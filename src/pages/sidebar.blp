using Gtk 4.0;
using Adw 1;

template $DesktopFilesEditorSideBar: Adw.NavigationPage {
  title: _("Applications");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      ToggleButton search_button {
        icon-name: "system-search-symbolic";
      }

      [end]
      MenuButton {
        primary: true;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        menu-model: primary_menu;
      }
    }

    content: Box {
      orientation: vertical;
      spacing: 4;

      SearchBar search_bar {
        search-mode-enabled: bind search_button.active bidirectional;

        SearchEntry search_entry {
          search-changed => $on_search_changed();
        }
      }

      ScrolledWindow {
        vexpand: true;

        child: ListBox list_box {
          selection-mode: single;
          row-selected => $on_row_selected();

          styles [
            "navigation-sidebar",
          ]
        };
      }
    };

    [bottom]
    Button button_create {
      child: Adw.ButtonContent {
        label: _("New app");
        icon-name: "list-add-symbolic";
      };

      action-name: "app.new-app";
      margin-top: 10;
      margin-bottom: 10;
      margin-start: 10;
      margin-end: 10;
    }
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Show hidden applications");
      action: "app.show-hidden-apps";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Desktop Files Editor");
      action: "app.about";
    }
  }
}
