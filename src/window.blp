using Gtk 4.0;
using Adw 1;

template $DesktopFilesEditorWindow: Adw.ApplicationWindow {
  title: "Desktop Files Editor";
  default-width: 800;
  default-height: 600;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationSplitView {
      sidebar: $DesktopFilesEditorSideBar sidebar {};

      content: $DesktopFilesEditorContent {
        selected-desktop: bind sidebar.selected-desktop;
      };
    };
  };
}
